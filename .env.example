TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
# Omit CODEX_APP_SERVER_URL to use the existing default Unix control socket.
# CODEX_APP_SERVER_URL=ws+unix:///absolute/path/to/app-server-control.sock:/
CODEX_TELEGRAM_PROJECTS=[{"name":"Project","cwd":"/absolute/path/to/project"}]
# Set an absolute multilingual whisper.cpp model path to enable local voice notes.
# CODEX_TELEGRAM_WHISPER_MODEL=/absolute/path/to/ggml-base.bin
# Set absolute executable paths if the bridge service cannot find them on PATH.
# CODEX_TELEGRAM_WHISPER_CLI=/absolute/path/to/whisper-cli
# CODEX_TELEGRAM_FFMPEG=/absolute/path/to/ffmpeg
