{
  "name": "codex-telegram-bridge",
  "version": "0.2.0",
  "description": "Private Telegram control for existing shared Codex daemon threads.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markrowan/codex-telegram-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/markrowan/codex-telegram-bridge/issues"
  },
  "homepage": "https://github.com/markrowan/codex-telegram-bridge#readme",
  "bin": {
    "codex-tg": "bin/codex-tg"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bridge.js",
    "access": "node dist/access.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-isolation=none tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "codex",
    "openai",
    "telegram",
    "app-server",
    "remote-control",
    "developer-tools"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "README.md",
    "README.ko.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "dependencies": {
    "grammy": "^1.42.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
