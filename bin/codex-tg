#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

COMMAND="${1:-status}"

case "$COMMAND" in
  setup|service|doctor)
    exec node "$ROOT_DIR/dist/access.js" "$@"
    ;;
  token|configure|configure-token)
    shift || true
    exec node "$ROOT_DIR/dist/access.js" setup "$@"
    ;;
  help|-h|--help)
    cat <<'EOF'
Usage:
  codex-tg setup                 Enter the bot token locally and choose a project
  codex-tg doctor                Show local configuration and journal health
  codex-tg service <command>     Install, start, stop, inspect or uninstall the user service
  codex-tg token                 Enter bot credentials with hidden local input
  codex-tg status                Show pairing/access state
  codex-tg pair <code>           Approve a Telegram pairing code
  codex-tg deny <code>           Deny a pending pairing code
  codex-tg allow <senderId>      Allow a Telegram sender id
  codex-tg remove <senderId>     Remove a Telegram sender id
  codex-tg policy allowlist      Lock the bot to the allowlist
  codex-tg policy pairing        Temporarily allow pairing codes
  codex-tg policy disabled       Drop all Telegram messages
EOF
    ;;
  *)
    exec node "$ROOT_DIR/dist/access.js" "$@"
    ;;
esac
